{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galixillion",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static game files. /api/* is handled by the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Daily Dives and cached validation verdicts.
  // Create with: npx wrangler kv namespace create PUZZLES  — then paste the id here.
  "kv_namespaces": [
    { "binding": "PUZZLES", "id": "009399ae9baf4d6780601aa5c71f7cf2" }
  ],

  // Per-IP limit on live answer validation.
  "ratelimits": [
    { "name": "VALIDATOR_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],

  // 00:05 UTC daily: generate the next two days' Daily Dives if missing.
  "triggers": { "crons": ["5 0 * * *"] },

  "vars": {
    "GENERATOR_MODEL": "claude-opus-5-5",
    "VALIDATOR_MODEL": "claude-haiku-5-5",
    "REQUIRE_REVIEW": "false",
    "LAUNCH_DATE": "2026-11-01"
  },

  "observability": { "enabled": true }
}
